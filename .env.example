# StrategyAI environment
# Copy to .env.local and fill in. Never commit .env.local.
#
# EVERY variable below is optional. With none of them set, the app runs on
# clearly-labelled mock providers - no signup, no keys, no cost.

# ---------------------------------------------------------------- providers
# Which implementation each provider interface resolves to.
# "mock" = deterministic demo data, labelled as such in the UI.
VISION_PROVIDER=mock            # mock | gemini
FINANCIAL_PROVIDER=mock         # mock | fmp | finnhub
MARKET_PROVIDER=mock            # mock | finnhub

# --- Vision (chart screenshot -> structured observations) ------------------
# Google AI Studio has a no-cost tier. Server-side only; never sent to the client.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# --- Fundamentals ----------------------------------------------------------
# Financial Modeling Prep and Finnhub both offer no-cost tiers with daily caps.
# Check the current limits when you sign up - they change.
FMP_API_KEY=
FINNHUB_API_KEY=

# ---------------------------------------------------------------- database
# Local development uses an embedded Postgres file (no server, no signup).
# For deployment, point this at a free-tier hosted Postgres.
DATABASE_URL=

# ---------------------------------------------------------------- auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------- engine
# Observations below this confidence are treated as INSUFFICIENT DATA.
ENGINE_MIN_CONFIDENCE=0.6
